# 複製成 .env 後修改；沒有 .env 就用下面的預設值
OLLAMA_URL=http://127.0.0.1:11434
# 不要改成 qwen3-vl:8b（那是 thinking 版）
VISION_MODEL=qwen3-vl:8b-instruct
# 上下文長度：3 張 1536px 圖約 5,000 tokens，16384 足夠，16GB 顯存放得下
NUM_CTX=16384

# ---- 批改系統（grade.py）----
# Padlet API key：https://padlet.com/dashboard/settings/developers （需付費帳號，且你要是作業版的管理員）
# 這把 key 等於你的 Padlet 帳號權限，不要貼到任何會同步或分享的地方
PADLET_API_KEY=
# 審核頁的連接埠（只給本機）
GRADER_PORT=8765
# 審核頁要給校內其他電腦（例如美術老師）用：改成 0.0.0.0，並先執行 grade.py set-password 設密碼
# 沒設密碼時伺服器會拒絕啟動。只給本機用就維持 127.0.0.1
GRADER_HOST=127.0.0.1
